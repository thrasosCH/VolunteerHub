@using VolunteerHub.Constants
@using VolunteerHub.Services
@model IEnumerable<VolunteerHub.Models.ParticipationRequest>

@inject ITimeService TimeService

@{
    ViewData["Title"] = "Volunteer Applications";

    var pendingCount =
        Model.Count(r =>
            r.Status == ParticipationRequestStatuses.Pending);

    var approvedCount =
        Model.Count(r =>
            r.Status == ParticipationRequestStatuses.Approved);

    var waitlistCount =
        Model.Count(r =>
            r.Status == ParticipationRequestStatuses.Waitlist);

    var completedCount =
        Model.Count(r =>
            r.Status == ParticipationRequestStatuses.Completed);
}


<!-- HEADER -->

<div class="row align-items-center g-4 mb-5">

    <div class="col-lg-8">

        <div class="section-eyebrow">
            Volunteer Management
        </div>

        <h1 class="mb-2">
            Volunteer Applications
        </h1>

        <p class="text-muted mb-0">
            Review applications, approve volunteers
            and keep track of participation.
        </p>

    </div>


    <div class="col-lg-4 text-lg-end">

        <a asp-controller="Dashboard"
           asp-action="Organizer"
           class="btn btn-outline-secondary">

            Back to Dashboard

        </a>

    </div>

</div>


<!-- MESSAGES -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">
        @TempData["Error"]
    </div>
}


<!-- SUMMARY -->

<div class="row g-4 mb-5">

    <div class="col-xl-3 col-md-6">

        <div class="card h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="text-muted small mb-2">
                            Pending
                        </div>

                        <div class="display-6 fw-bold">
                            @pendingCount
                        </div>

                    </div>

                    <div class="category-icon mb-0">
                        ⏳
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-3 col-md-6">

        <div class="card h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="text-muted small mb-2">
                            Approved
                        </div>

                        <div class="display-6 fw-bold">
                            @approvedCount
                        </div>

                    </div>

                    <div class="category-icon mb-0">
                        ✅
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-3 col-md-6">

        <div class="card h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="text-muted small mb-2">
                            Waitlist
                        </div>

                        <div class="display-6 fw-bold">
                            @waitlistCount
                        </div>

                    </div>

                    <div class="category-icon mb-0">
                        🕓
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-3 col-md-6">

        <div class="card h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="text-muted small mb-2">
                            Completed
                        </div>

                        <div class="display-6 fw-bold">
                            @completedCount
                        </div>

                    </div>

                    <div class="category-icon mb-0">
                        🌱
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- APPLICATIONS -->

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">

    <div>

        <div class="section-eyebrow">
            Applications
        </div>

        <h2 class="h3 mb-0">
            All Volunteer Requests
        </h2>

    </div>

    <span class="badge bg-light text-dark border">
        @Model.Count()
        @(Model.Count() == 1 ? "application" : "applications")
    </span>

</div>


@if (Model.Any())
{
    <div class="row g-4">

        @foreach (var request in Model)
        {
            var volunteerAction =
                request.Shift.VolunteerAction;

            var actionStatus =
                volunteerAction.Status;

            var timeZoneId =
                volunteerAction.City?
                    .Country?
                    .TimeZoneId;

            bool hasTimeZone =
                !string.IsNullOrWhiteSpace(timeZoneId);

            DateTime localNow =
                hasTimeZone
                    ? TimeService.GetCurrentLocalTime(timeZoneId!)
                    : default;


            bool canReviewApplication =
                hasTimeZone &&

                (
                    request.Status ==
                        ParticipationRequestStatuses.Pending ||

                    request.Status ==
                        ParticipationRequestStatuses.Waitlist
                ) &&

                actionStatus ==
                    VolunteerActionStatuses.Published &&

                localNow <
                    request.Shift.StartTime;


            bool canMarkAttendance =
                hasTimeZone &&

                request.Status ==
                    ParticipationRequestStatuses.Approved &&

                (
                    actionStatus ==
                        VolunteerActionStatuses.InProgress ||

                    actionStatus ==
                        VolunteerActionStatuses.Completed
                ) &&

                localNow >=
                    request.Shift.StartTime;


            <div class="col-xl-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body p-4 d-flex flex-column">

                        <!-- TOP -->

                        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

                            <div>

                                <h3 class="h5 mb-1">
                                    @request.Volunteer.FullName
                                </h3>

                                <div class="text-muted small">
                                    @request.Volunteer.Email
                                </div>

                            </div>


                            @switch (request.Status)
                            {
                                case ParticipationRequestStatuses.Pending:

                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>

                                    break;


                                case ParticipationRequestStatuses.Approved:

                                    <span class="badge bg-success">
                                        Approved
                                    </span>

                                    break;


                                case ParticipationRequestStatuses.Waitlist:

                                    <span class="badge bg-info">
                                        Waitlist
                                    </span>

                                    break;


                                case ParticipationRequestStatuses.Rejected:

                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>

                                    break;


                                case ParticipationRequestStatuses.Completed:

                                    <span class="badge bg-dark">
                                        Completed
                                    </span>

                                    break;


                                case ParticipationRequestStatuses.Cancelled:

                                    <span class="badge bg-secondary">
                                        Cancelled
                                    </span>

                                    break;


                                default:

                                    <span class="badge bg-secondary">
                                        @request.Status
                                    </span>

                                    break;
                            }

                        </div>


                        <!-- OPPORTUNITY -->

                        <div class="eco-panel mb-4">

                            <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">

                                <div>

                                    <div class="text-muted small mb-1">
                                        Opportunity
                                    </div>

                                    <div class="fw-semibold">
                                        @volunteerAction.Title
                                    </div>

                                </div>


                                @if (actionStatus ==
                                    VolunteerActionStatuses.Published)
                                {
                                    <span class="badge bg-primary">
                                        Published
                                    </span>
                                }
                                else if (actionStatus ==
                                    VolunteerActionStatuses.InProgress)
                                {
                                    <span class="badge bg-success">
                                        In Progress
                                    </span>
                                }
                                else if (actionStatus ==
                                    VolunteerActionStatuses.Completed)
                                {
                                    <span class="badge bg-dark">
                                        Completed
                                    </span>
                                }
                                else if (actionStatus ==
                                    VolunteerActionStatuses.Cancelled)
                                {
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @actionStatus
                                    </span>
                                }

                            </div>


                            <div class="small mb-2">

                                <span class="me-2">
                                    📍
                                </span>

                                @if (volunteerAction.City != null &&
                                     volunteerAction.City.Country != null)
                                {
                                    <span>
                                        @volunteerAction.City.Name,
                                        @volunteerAction.City.Country.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Location not specified
                                    </span>
                                }

                            </div>


                            <div class="small mb-2">

                                <span class="me-2">
                                    🕒
                                </span>

                                @request.Shift.Title

                            </div>


                            <div class="small">

                                <span class="me-2">
                                    📅
                                </span>

                                @request.Shift.StartTime.ToString(
                                    "dd MMM yyyy, HH:mm")

                                -

                                @request.Shift.EndTime.ToString("HH:mm")

                            </div>

                        </div>


                        <!-- APPLICATION INFORMATION -->

                        <div class="row g-3 mb-4">

                            <div class="col-sm-6">

                                <div class="text-muted small">
                                    Applied On
                                </div>

                                <div class="fw-semibold">
                                    @request.ApplicationDate.ToString(
                                        "dd MMM yyyy, HH:mm")
                                </div>

                            </div>


                            <div class="col-sm-6">

                                <div class="text-muted small">
                                    Attendance
                                </div>

                                <div class="fw-semibold">

                                    @if (request.Attended)
                                    {
                                        <span class="text-success">
                                            Attended
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Not recorded
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(request.Message))
                        {
                            <div class="mb-4">

                                <div class="text-muted small mb-1">
                                    Message from Volunteer
                                </div>

                                <div>
                                    @request.Message
                                </div>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(
                            request.OrganizerNotes))
                        {
                            <div class="mb-4">

                                <div class="text-muted small mb-1">
                                    Organizer Notes
                                </div>

                                <div>
                                    @request.OrganizerNotes
                                </div>

                            </div>
                        }


                        <!-- ACTION BUTTONS -->

                        <div class="mt-auto">

                            @if (!hasTimeZone)
                            {
                                <div class="alert alert-warning mb-0 small">

                                    The opportunity time zone could not be determined.
                                    Application actions are temporarily unavailable.

                                </div>
                            }
                            else
                            {
                                @if (canReviewApplication)
                                {
                                    <div class="d-flex flex-wrap gap-2">

                                        <form asp-action="Approve"
                                              asp-route-id="@request.Id"
                                              method="post">

                                            <button type="submit"
                                                    class="btn btn-primary">

                                                Approve

                                            </button>

                                        </form>


                                        <form asp-action="Reject"
                                              asp-route-id="@request.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to reject this application?');">

                                            <button type="submit"
                                                    class="btn btn-outline-danger">

                                                Reject

                                            </button>

                                        </form>

                                    </div>
                                }
                                else if (
                                    request.Status ==
                                        ParticipationRequestStatuses.Pending ||

                                    request.Status ==
                                        ParticipationRequestStatuses.Waitlist)
                                {
                                    @if (actionStatus !=
                                        VolunteerActionStatuses.Published)
                                    {
                                        <div class="alert alert-light border mb-0 small">

                                            This application can no longer be reviewed
                                            because the opportunity is not currently published.

                                        </div>
                                    }
                                    else if (localNow >=
                                        request.Shift.StartTime)
                                    {
                                        <div class="alert alert-light border mb-0 small">

                                            This shift has already started.
                                            The application can no longer be approved or rejected.

                                        </div>
                                    }
                                }


                                @if (request.Status ==
                                    ParticipationRequestStatuses.Approved)
                                {
                                    @if (canMarkAttendance)
                                    {
                                        <form asp-action="MarkAttended"
                                              asp-route-id="@request.Id"
                                              method="post"
                                              onsubmit="return confirm('Confirm that this volunteer attended the shift?');">

                                            <button type="submit"
                                                    class="btn btn-primary">

                                                Mark as Attended

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        @if (actionStatus ==
                                            VolunteerActionStatuses.Cancelled)
                                        {
                                            <div class="alert alert-light border mb-0 small">

                                                Attendance cannot be recorded because
                                                this opportunity was cancelled.

                                            </div>
                                        }
                                        else if (localNow <
                                            request.Shift.StartTime)
                                        {
                                            <div class="alert alert-light border mb-0 small">

                                                Attendance can be recorded after the shift starts.

                                            </div>
                                        }
                                        else if (actionStatus ==
                                            VolunteerActionStatuses.Published)
                                        {
                                            <div class="alert alert-light border mb-0 small">

                                                Start the opportunity before recording attendance.

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-light border mb-0 small">

                                                Attendance cannot currently be recorded
                                                for this application.

                                            </div>
                                        }
                                    }
                                }
                            }


                            @if (request.Status ==
                                ParticipationRequestStatuses.Completed)
                            {
                                <div class="d-flex align-items-center gap-2 text-success fw-semibold">

                                    <span>
                                        ✓
                                    </span>

                                    Participation completed

                                </div>
                            }


                            @if (request.Status ==
                                ParticipationRequestStatuses.Rejected)
                            {
                                <div class="text-muted">
                                    This application was rejected.
                                </div>
                            }


                            @if (request.Status ==
                                ParticipationRequestStatuses.Cancelled)
                            {
                                <div class="text-muted">
                                    This application was cancelled by the volunteer.
                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="eco-panel text-center py-5">

        <div class="mb-3"
             style="font-size: 3rem;">
            🤝
        </div>

        <h2 class="h5">
            No volunteer applications yet
        </h2>

        <p class="text-muted mb-4">
            Applications will appear here when volunteers
            apply to one of your available shifts.
        </p>

        <a asp-controller="VolunteerActions"
           asp-action="MyActions"
           class="btn btn-primary">

            View My Actions

        </a>

    </div>
}