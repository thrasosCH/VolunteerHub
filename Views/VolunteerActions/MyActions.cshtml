@using VolunteerHub.Constants
@using VolunteerHub.Services
@model IEnumerable<VolunteerHub.Models.VolunteerAction>

@inject ITimeService TimeService

@{
    ViewData["Title"] = "My Volunteer Actions";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <div>

        <div class="section-eyebrow">
            Organizer
        </div>

        <h1 class="mb-1">
            My Volunteer Actions
        </h1>

        <p class="text-muted mb-0">
            Create, publish and manage your volunteering opportunities.
        </p>

    </div>


    <a asp-action="Create"
       class="btn btn-primary">

        Create New Action

    </a>

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">
        @TempData["Success"]
    </div>
}


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">
        @TempData["Error"]
    </div>
}


@if (Model.Any())
{
    <div class="row g-4">

        @foreach (var action in Model)
        {
            var timeZoneId =
                action.City?
                    .Country?
                    .TimeZoneId;

            bool hasTimeZone =
                !string.IsNullOrWhiteSpace(
                    timeZoneId);

            DateTime localNow =
                hasTimeZone
                    ? TimeService.GetCurrentLocalTime(
                        timeZoneId!)
                    : default;


            <div class="col-xl-4 col-md-6">

                <div class="card h-100 shadow-sm">

                    <!-- CATEGORY VISUAL -->

                    <div class="d-flex align-items-center justify-content-center"
                         style="
                            height: 160px;
                            background: linear-gradient(
                                135deg,
                                #eef9f2,
                                #dff4e8
                            );
                            font-size: 3.5rem;
                         ">

                        @switch (action.Category)
                        {
                            case VolunteerActionCategories.Environment:
                                <span>🌿</span>
                                break;

                            case VolunteerActionCategories.Animals:
                                <span>🐾</span>
                                break;

                            case VolunteerActionCategories.Social:
                                <span>🤝</span>
                                break;

                            case VolunteerActionCategories.Education:
                                <span>📚</span>
                                break;

                            case VolunteerActionCategories.Health:
                                <span>💚</span>
                                break;

                            default:
                                <span>✨</span>
                                break;
                        }

                    </div>


                    <div class="card-body d-flex flex-column p-4">

                        <!-- BADGES -->

                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">

                            <span class="badge bg-light text-dark border">
                                @action.Category
                            </span>


                            @switch (action.Status)
                            {
                                case VolunteerActionStatuses.Draft:

                                    <span class="badge bg-secondary">
                                        Draft
                                    </span>

                                    break;


                                case VolunteerActionStatuses.Published:

                                    <span class="badge bg-primary">
                                        Published
                                    </span>

                                    break;


                                case VolunteerActionStatuses.InProgress:

                                    <span class="badge bg-success">
                                        In Progress
                                    </span>

                                    break;


                                case VolunteerActionStatuses.Completed:

                                    <span class="badge bg-dark">
                                        Completed
                                    </span>

                                    break;


                                case VolunteerActionStatuses.Cancelled:

                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>

                                    break;


                                default:

                                    <span class="badge bg-secondary">
                                        @action.Status
                                    </span>

                                    break;
                            }

                        </div>


                        <!-- TITLE -->

                        <h2 class="h5 mb-3">
                            @action.Title
                        </h2>


                        <!-- LOCATION -->

                        <div class="small mb-2">

                            <strong>
                                Location:
                            </strong>

                            @if (action.City != null &&
                                 action.City.Country != null)
                            {
                                <span>
                                    @action.City.Name,
                                    @action.City.Country.Name
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not specified
                                </span>
                            }

                        </div>


                        <!-- START -->

                        <div class="small mb-2">

                            <strong>
                                Starts:
                            </strong>

                            @action.StartDate.ToString(
                                "dd MMM yyyy, HH:mm")

                        </div>


                        <!-- END -->

                        <div class="small mb-2">

                            <strong>
                                Ends:
                            </strong>

                            @action.EndDate.ToString(
                                "dd MMM yyyy, HH:mm")

                        </div>


                        <!-- DEADLINE -->

                        <div class="small mb-4">

                            <strong>
                                Application Deadline:
                            </strong>

                            @action.ApplicationDeadline.ToString(
                                "dd MMM yyyy, HH:mm")

                        </div>


                        <!-- ACTION BUTTONS -->

                        <div class="mt-auto">

                            <div class="d-grid gap-2 mb-2">

                                <a asp-action="Details"
                                   asp-route-id="@action.Id"
                                   class="btn btn-outline-primary">

                                    View Details

                                </a>


                                @if (action.Status ==
                                        VolunteerActionStatuses.Draft ||

                                     action.Status ==
                                        VolunteerActionStatuses.Published)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@action.Id"
                                       class="btn btn-outline-secondary">

                                        Edit Action

                                    </a>
                                }


                                <a asp-controller="Shifts"
                                   asp-action="Index"
                                   asp-route-actionId="@action.Id"
                                   class="btn btn-outline-secondary">

                                    Manage Shifts

                                </a>

                            </div>


                            <!-- DRAFT -->

                            @if (action.Status ==
                                VolunteerActionStatuses.Draft)
                            {
                                <form asp-action="Publish"
                                      asp-route-id="@action.Id"
                                      method="post">

                                    <button type="submit"
                                            class="btn btn-primary w-100">

                                        Publish Action

                                    </button>

                                </form>
                            }


                            <!-- PUBLISHED -->

                            @if (action.Status ==
                                VolunteerActionStatuses.Published)
                            {
                                <div class="d-grid gap-2">

                                    @if (!hasTimeZone)
                                    {
                                        <div class="alert alert-warning py-2 px-3 mb-0 small">

                                            The opportunity time zone could not be determined.
                                            Starting the opportunity is temporarily unavailable.

                                        </div>
                                    }
                                    else if (localNow < action.StartDate)
                                    {
                                        <div class="alert alert-info py-2 px-3 mb-0 small">

                                            This opportunity can be started on
                                            <strong>
                                                @action.StartDate.ToString(
                                                    "dd MMM yyyy, HH:mm")
                                            </strong>.

                                        </div>
                                    }
                                    else if (localNow >= action.EndDate)
                                    {
                                        <div class="alert alert-warning py-2 px-3 mb-0 small">

                                            The scheduled time for this opportunity
                                            has already ended.

                                        </div>
                                    }
                                    else
                                    {
                                        <form asp-action="Start"
                                              asp-route-id="@action.Id"
                                              method="post">

                                            <button type="submit"
                                                    class="btn btn-success w-100">

                                                Start Action

                                            </button>

                                        </form>
                                    }


                                    <form asp-action="Cancel"
                                          asp-route-id="@action.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this opportunity?');">

                                        <button type="submit"
                                                class="btn btn-outline-danger w-100">

                                            Cancel Action

                                        </button>

                                    </form>

                                </div>
                            }


                            <!-- IN PROGRESS -->

                            @if (action.Status ==
                                VolunteerActionStatuses.InProgress)
                            {
                                <div class="d-grid gap-2">

                                    <form asp-action="Complete"
                                          asp-route-id="@action.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to mark this opportunity as completed?');">

                                        <button type="submit"
                                                class="btn btn-success w-100">

                                            Complete Action

                                        </button>

                                    </form>


                                    <form asp-action="Cancel"
                                          asp-route-id="@action.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this opportunity?');">

                                        <button type="submit"
                                                class="btn btn-outline-danger w-100">

                                            Cancel Action

                                        </button>

                                    </form>

                                </div>
                            }


                            <!-- COMPLETED -->

                            @if (action.Status ==
                                VolunteerActionStatuses.Completed)
                            {
                                <div class="alert alert-success py-2 px-3 mb-0 small">

                                    This opportunity has been completed.

                                </div>
                            }


                            <!-- CANCELLED -->

                            @if (action.Status ==
                                VolunteerActionStatuses.Cancelled)
                            {
                                <div class="alert alert-secondary py-2 px-3 mb-0 small">

                                    This opportunity has been cancelled.

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="eco-panel text-center py-5">

        <div class="mb-3"
             style="font-size: 3rem;">
            🌱
        </div>

        <h2 class="h5">
            No volunteer actions yet
        </h2>

        <p class="text-muted">
            Create your first volunteering opportunity and start recruiting volunteers.
        </p>

        <a asp-action="Create"
           class="btn btn-primary">

            Create Your First Action

        </a>

    </div>
}