@using Microsoft.AspNetCore.Identity
@using VolunteerHub.Constants
@using VolunteerHub.Models
@using VolunteerHub.Services

@model VolunteerHub.Models.VolunteerAction

@inject UserManager<ApplicationUser> UserManager
@inject ITimeService TimeService

@{
    ViewData["Title"] = Model.Title;

    var currentUserId = UserManager.GetUserId(User);

    bool isOwner =
        User.Identity?.IsAuthenticated == true &&
        Model.OrganizerId == currentUserId;


    var timeZoneId =
        Model.City?
            .Country?
            .TimeZoneId;


    bool hasTimeZone =
        !string.IsNullOrWhiteSpace(
            timeZoneId);


    DateTime localNow =
        hasTimeZone
            ? TimeService.GetCurrentLocalTime(
                timeZoneId!)
            : default;


    bool canApply =
        hasTimeZone &&
        User.IsInRole(UserRoles.Volunteer) &&
        Model.Status == VolunteerActionStatuses.Published &&
        localNow <= Model.ApplicationDeadline;
}


<div class="mb-4">

    <a asp-action="Index"
       class="text-decoration-none">

        ← Back to Opportunities

    </a>

</div>


<div class="row g-4">

    <!-- MAIN CONTENT -->

    <div class="col-lg-8">

        <div class="card mb-4">

            <div class="card-body p-4 p-md-5">

                <!-- STATUS -->

                <div class="d-flex flex-wrap gap-2 mb-3">

                    <span class="badge bg-light text-dark border">
                        @Model.Category
                    </span>


                    @if (Model.Status == VolunteerActionStatuses.Published)
                    {
                        <span class="badge bg-primary">
                            Open
                        </span>
                    }
                    else if (Model.Status == VolunteerActionStatuses.InProgress)
                    {
                        <span class="badge bg-success">
                            In Progress
                        </span>
                    }
                    else if (Model.Status == VolunteerActionStatuses.Completed)
                    {
                        <span class="badge bg-secondary">
                            Completed
                        </span>
                    }
                    else if (Model.Status == VolunteerActionStatuses.Cancelled)
                    {
                        <span class="badge bg-danger">
                            Cancelled
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    }

                </div>


                <!-- TITLE -->

                <h1 class="mb-3">
                    @Model.Title
                </h1>


                <!-- ORGANIZER -->

                <div class="text-muted mb-4">

                    Organized by

                    <strong class="text-dark">

                        @(string.IsNullOrWhiteSpace(Model.Organizer?.FullName)
                            ? "VolunteerHub Organizer"
                            : Model.Organizer.FullName)

                    </strong>

                </div>


                <!-- DESCRIPTION -->

                <h2 class="h5">
                    About this opportunity
                </h2>

                <p style="white-space: pre-line;">
                    @Model.Description
                </p>


                <!-- INSTRUCTIONS -->

                @if (!string.IsNullOrWhiteSpace(Model.Instructions))
                {
                    <hr class="my-4" />

                    <h2 class="h5">
                        Additional Instructions
                    </h2>

                    <p style="white-space: pre-line;">
                        @Model.Instructions
                    </p>
                }

            </div>

        </div>


        <!-- SHIFTS -->

        <div class="card">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h2 class="h4 mb-1">
                            Available Shifts
                        </h2>

                        <p class="text-muted mb-0">
                            Choose the shift that works best for you.
                        </p>

                    </div>


                    @if (isOwner)
                    {
                        <a asp-controller="Shifts"
                           asp-action="Index"
                           asp-route-actionId="@Model.Id"
                           class="btn btn-outline-primary">

                            Manage Shifts

                        </a>
                    }

                </div>


                @if (Model.Shifts != null &&
                     Model.Shifts.Any())
                {
                    <div class="d-flex flex-column gap-3">

                        @foreach (var shift in Model.Shifts
                            .OrderBy(s => s.StartTime))
                        {
                            <div class="border rounded-3 p-3">

                                <div class="row align-items-center g-3">

                                    <div class="col-lg-8">

                                        <h3 class="h6 mb-2">
                                            @shift.Title
                                        </h3>


                                        <div class="text-muted small mb-2">

                                            @shift.StartTime.ToString("dd MMM yyyy")

                                            ·

                                            @shift.StartTime.ToString("HH:mm")

                                            -

                                            @shift.EndTime.ToString("HH:mm")

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(
                                            shift.Description))
                                        {
                                            <p class="mb-2">
                                                @shift.Description
                                            </p>
                                        }


                                        <div class="small">

                                            <strong>
                                                Capacity:
                                            </strong>

                                            @shift.MaxVolunteers volunteers


                                            @if (!string.IsNullOrWhiteSpace(
                                                shift.RequiredSkill))
                                            {
                                                <span class="mx-2">
                                                    •
                                                </span>

                                                <strong>
                                                    Required skill:
                                                </strong>

                                                @shift.RequiredSkill
                                            }

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(
                                            shift.Notes))
                                        {
                                            <div class="small text-muted mt-2">
                                                @shift.Notes
                                            </div>
                                        }

                                    </div>


                                    <div class="col-lg-4 text-lg-end">

                                        @if (canApply)
                                        {
                                            <a asp-controller="ParticipationRequests"
                                               asp-action="Apply"
                                               asp-route-shiftId="@shift.Id"
                                               class="btn btn-primary">

                                                Apply for Shift

                                            </a>
                                        }
                                        else if (User.Identity?.IsAuthenticated != true)
                                        {
                                            <a asp-area="Identity"
                                               asp-page="/Account/Login"
                                               class="btn btn-outline-primary">

                                                Sign in to Apply

                                            </a>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-center py-4">

                        <h3 class="h6">
                            No shifts available yet
                        </h3>

                        <p class="text-muted mb-0">
                            The organizer has not added any shifts for this opportunity.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- SIDEBAR -->

    <div class="col-lg-4">

        <div class="card mb-4">

            <div class="card-body p-4">

                <h2 class="h5 mb-4">
                    Opportunity Details
                </h2>


                <!-- LOCATION -->

                <div class="mb-4">

                    <div class="text-muted small">
                        Location
                    </div>

                    <div class="fw-semibold">

                        @if (Model.City != null &&
                             Model.City.Country != null)
                        {
                            @($"{Model.City.Name}, {Model.City.Country.Name}")
                        }
                        else
                        {
                            <span>
                                Not specified
                            </span>
                        }

                    </div>

                </div>


                <!-- START -->

                <div class="mb-4">

                    <div class="text-muted small">
                        Starts
                    </div>

                    <div class="fw-semibold">
                        @Model.StartDate.ToString(
                            "dd MMM yyyy, HH:mm")
                    </div>

                </div>


                <!-- END -->

                <div class="mb-4">

                    <div class="text-muted small">
                        Ends
                    </div>

                    <div class="fw-semibold">
                        @Model.EndDate.ToString(
                            "dd MMM yyyy, HH:mm")
                    </div>

                </div>


                <!-- DEADLINE -->

                <div class="mb-4">

                    <div class="text-muted small">
                        Application Deadline
                    </div>

                    <div class="fw-semibold">
                        @Model.ApplicationDeadline.ToString(
                            "dd MMM yyyy, HH:mm")
                    </div>

                </div>


                <!-- AGE -->

                @if (Model.MinimumAge.HasValue)
                {
                    <div class="mb-4">

                        <div class="text-muted small">
                            Minimum Age
                        </div>

                        <div class="fw-semibold">
                            @Model.MinimumAge+
                        </div>

                    </div>
                }


                <!-- CONTACT -->

                <div>

                    <div class="text-muted small">
                        Contact
                    </div>

                    <div class="fw-semibold text-break">
                        @Model.ContactInfo
                    </div>

                </div>

            </div>

        </div>


        <!-- ORGANIZER TOOLS -->

        @if (isOwner)
        {
            <div class="card">

                <div class="card-body p-4">

                    <h2 class="h5 mb-3">
                        Organizer Tools
                    </h2>


                    <div class="d-grid gap-2">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-primary">

                            Edit Action

                        </a>


                        <a asp-controller="Shifts"
                           asp-action="Index"
                           asp-route-actionId="@Model.Id"
                           class="btn btn-outline-secondary">

                            Manage Shifts

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>