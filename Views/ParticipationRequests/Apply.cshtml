@{
    ViewData["Title"] = "Apply for Shift";

    var shift =
        ViewBag.Shift as VolunteerHub.Models.Shift;
}

@if (shift == null)
{
    <div class="alert alert-danger">
        The selected shift could not be found.
    </div>

    return;
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="mb-4">

            <a asp-controller="VolunteerActions"
               asp-action="Details"
               asp-route-id="@shift.VolunteerActionId"
               class="text-decoration-none">
                ← Back to Opportunity
            </a>

            <h1 class="mt-3 mb-1">
                Apply for Shift
            </h1>

            <p class="text-muted mb-0">
                Review the shift details and submit your application.
            </p>

        </div>


        <div class="card mb-4">

            <div class="card-body p-4">

                <h2 class="h5 mb-3">
                    @shift.VolunteerAction.Title
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="text-muted small">
                            Shift
                        </div>

                        <div class="fw-semibold">
                            @shift.Title
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small">
                            Location
                        </div>

                        <div class="fw-semibold">

                            @if (shift.VolunteerAction.City != null &&
                                 shift.VolunteerAction.City.Country != null)
                            {
                                @($"{shift.VolunteerAction.City.Name}, {shift.VolunteerAction.City.Country.Name}")
                            }
                            else
                            {
                                <span>Not specified</span>
                            }

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small">
                            Date
                        </div>

                        <div class="fw-semibold">
                            @shift.StartTime.ToString("dd MMM yyyy")
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small">
                            Time
                        </div>

                        <div class="fw-semibold">
                            @shift.StartTime.ToString("HH:mm")
                            -
                            @shift.EndTime.ToString("HH:mm")
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small">
                            Maximum Volunteers
                        </div>

                        <div class="fw-semibold">
                            @shift.MaxVolunteers
                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(shift.RequiredSkill))
                    {
                        <div class="col-md-6">

                            <div class="text-muted small">
                                Required Skill
                            </div>

                            <div class="fw-semibold">
                                @shift.RequiredSkill
                            </div>

                        </div>
                    }

                </div>


                @if (!string.IsNullOrWhiteSpace(shift.Description))
                {
                    <hr class="my-4" />

                    <div class="text-muted small mb-1">
                        Shift Description
                    </div>

                    <p class="mb-0">
                        @shift.Description
                    </p>
                }

            </div>

        </div>


        <div class="card">

            <div class="card-body p-4 p-md-5">

                <h2 class="h5 mb-3">
                    Your Application
                </h2>

                <form asp-action="Apply"
                      method="post">

                    <input type="hidden"
                           name="shiftId"
                           value="@shift.Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    <div class="mb-4">

                        <label for="message"
                               class="form-label">
                            Message to Organizer
                        </label>

                        <textarea name="message"
                                  id="message"
                                  class="form-control"
                                  rows="5"
                                  maxlength="1000"
                                  placeholder="Optional: introduce yourself or explain why you would like to join this shift.">@ViewData["Message"]</textarea>

                        <div class="form-text">
                            Optional. Maximum 1000 characters.
                        </div>

                        <span class="text-danger">
                            @Html.ValidationMessage("Message")
                        </span>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            Submit Application

                        </button>

                        <a asp-controller="VolunteerActions"
                           asp-action="Details"
                           asp-route-id="@shift.VolunteerActionId"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>