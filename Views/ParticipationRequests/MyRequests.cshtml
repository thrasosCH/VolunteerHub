@using VolunteerHub.Constants
@using VolunteerHub.Services
@model IEnumerable<VolunteerHub.Models.ParticipationRequest>

@inject ITimeService TimeService

@{
    ViewData["Title"] = "My Applications";
}


<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <div>

        <h1 class="mb-1">
            My Applications
        </h1>

        <p class="text-muted mb-0">
            Track the status of your volunteer applications.
        </p>

    </div>


    <a asp-controller="VolunteerActions"
       asp-action="Index"
       class="btn btn-primary">

        Find Opportunities

    </a>

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


@if (Model.Any())
{
    <div class="row g-4">

        @foreach (var request in Model)
        {
            var volunteerAction =
                request.Shift.VolunteerAction;

            var actionStatus =
                volunteerAction.Status;


            var timeZoneId =
                volunteerAction.City?
                    .Country?
                    .TimeZoneId;


            bool hasTimeZone =
                !string.IsNullOrWhiteSpace(
                    timeZoneId);


            DateTime localNow =
                hasTimeZone
                    ? TimeService.GetCurrentLocalTime(
                        timeZoneId!)
                    : default;


            bool activeApplication =
                request.Status ==
                    ParticipationRequestStatuses.Pending ||

                request.Status ==
                    ParticipationRequestStatuses.Approved ||

                request.Status ==
                    ParticipationRequestStatuses.Waitlist;


            bool activeOpportunity =
                actionStatus ==
                    VolunteerActionStatuses.Published ||

                actionStatus ==
                    VolunteerActionStatuses.InProgress;


            bool shiftNotStarted =
                hasTimeZone &&
                localNow <
                    request.Shift.StartTime;


            bool canCancel =
                activeApplication &&
                activeOpportunity &&
                shiftNotStarted;


            <div class="col-lg-6">

                <div class="card h-100 shadow-sm">

                    <div class="card-body p-4 d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">

                            <div>

                                <h2 class="h5 mb-1">
                                    @volunteerAction.Title
                                </h2>

                                <div class="text-muted small">
                                    @request.Shift.Title
                                </div>

                            </div>


                            @switch (request.Status)
                            {
                                case ParticipationRequestStatuses.Pending:

                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>

                                    break;


                                case ParticipationRequestStatuses.Approved:

                                    <span class="badge bg-success">
                                        Approved
                                    </span>

                                    break;


                                case ParticipationRequestStatuses.Waitlist:

                                    <span class="badge bg-info text-dark">
                                        Waitlist
                                    </span>

                                    break;


                                case ParticipationRequestStatuses.Rejected:

                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>

                                    break;


                                case ParticipationRequestStatuses.Cancelled:

                                    <span class="badge bg-secondary">
                                        Cancelled
                                    </span>

                                    break;


                                case ParticipationRequestStatuses.Completed:

                                    <span class="badge bg-dark">
                                        Completed
                                    </span>

                                    break;


                                default:

                                    <span class="badge bg-secondary">
                                        @request.Status
                                    </span>

                                    break;
                            }

                        </div>


                        <!-- OPPORTUNITY STATUS -->

                        <div class="mb-3">

                            <div class="text-muted small">
                                Opportunity Status
                            </div>

                            <div>

                                @if (actionStatus ==
                                    VolunteerActionStatuses.Published)
                                {
                                    <span class="badge bg-primary">
                                        Published
                                    </span>
                                }
                                else if (actionStatus ==
                                    VolunteerActionStatuses.InProgress)
                                {
                                    <span class="badge bg-success">
                                        In Progress
                                    </span>
                                }
                                else if (actionStatus ==
                                    VolunteerActionStatuses.Completed)
                                {
                                    <span class="badge bg-dark">
                                        Completed
                                    </span>
                                }
                                else if (actionStatus ==
                                    VolunteerActionStatuses.Cancelled)
                                {
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @actionStatus
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- LOCATION -->

                        <div class="mb-3">

                            <div class="text-muted small">
                                Location
                            </div>

                            <div class="fw-semibold">

                                @if (volunteerAction.City != null &&
                                     volunteerAction.City.Country != null)
                                {
                                    @($"{volunteerAction.City.Name}, {volunteerAction.City.Country.Name}")
                                }
                                else
                                {
                                    <span>
                                        Not specified
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- DATE & TIME -->

                        <div class="row mb-3">

                            <div class="col-sm-6">

                                <div class="text-muted small">
                                    Date
                                </div>

                                <div class="fw-semibold">
                                    @request.Shift.StartTime.ToString(
                                        "dd MMM yyyy")
                                </div>

                            </div>


                            <div class="col-sm-6">

                                <div class="text-muted small">
                                    Time
                                </div>

                                <div class="fw-semibold">

                                    @request.Shift.StartTime.ToString("HH:mm")
                                    -
                                    @request.Shift.EndTime.ToString("HH:mm")

                                </div>

                            </div>

                        </div>


                        <!-- APPLICATION DATE -->

                        <div class="mb-3">

                            <div class="text-muted small">
                                Applied On
                            </div>

                            <div class="fw-semibold">
                                @request.ApplicationDate.ToString(
                                    "dd MMM yyyy, HH:mm")
                            </div>

                        </div>


                        <!-- MESSAGE -->

                        @if (!string.IsNullOrWhiteSpace(
                            request.Message))
                        {
                            <div class="mb-3">

                                <div class="text-muted small">
                                    Your Message
                                </div>

                                <div>
                                    @request.Message
                                </div>

                            </div>
                        }


                        <!-- ORGANIZER NOTES -->

                        @if (!string.IsNullOrWhiteSpace(
                            request.OrganizerNotes))
                        {
                            <div class="mb-3">

                                <div class="text-muted small">
                                    Organizer Notes
                                </div>

                                <div>
                                    @request.OrganizerNotes
                                </div>

                            </div>
                        }


                        <!-- ATTENDANCE -->

                        @if (request.Status ==
                            ParticipationRequestStatuses.Completed)
                        {
                            <div class="mb-3">

                                <div class="text-muted small">
                                    Attendance
                                </div>


                                @if (request.Attended)
                                {
                                    <span class="badge bg-success">
                                        Attended
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Not Marked as Attended
                                    </span>
                                }

                            </div>
                        }


                        <!-- ACTIONS -->

                        <div class="mt-auto pt-2">

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-controller="VolunteerActions"
                                   asp-action="Details"
                                   asp-route-id="@request.Shift.VolunteerActionId"
                                   class="btn btn-outline-primary">

                                    View Opportunity

                                </a>


                                @if (canCancel)
                                {
                                    <form asp-action="Cancel"
                                          asp-route-id="@request.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this application?');">

                                        <button type="submit"
                                                class="btn btn-outline-danger">

                                            Cancel Application

                                        </button>

                                    </form>
                                }

                            </div>


                            @if (activeApplication &&
                                 !canCancel)
                            {
                                <div class="mt-3">

                                    @if (!hasTimeZone)
                                    {
                                        <div class="alert alert-warning mb-0 small">

                                            The opportunity time zone could not be determined.
                                            Cancellation is temporarily unavailable.

                                        </div>
                                    }
                                    else if (!activeOpportunity)
                                    {
                                        <div class="alert alert-light border mb-0 small">

                                            This application can no longer be cancelled
                                            because the opportunity is no longer active.

                                        </div>
                                    }
                                    else if (!shiftNotStarted)
                                    {
                                        <div class="alert alert-light border mb-0 small">

                                            This application can no longer be cancelled
                                            because the shift has already started.

                                        </div>
                                    }

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="card">

        <div class="card-body text-center py-5">

            <h2 class="h5">
                No applications yet
            </h2>

            <p class="text-muted mb-4">
                Find a volunteering opportunity and submit your first application.
            </p>

            <a asp-controller="VolunteerActions"
               asp-action="Index"
               class="btn btn-primary">

                Browse Opportunities

            </a>

        </div>

    </div>
}