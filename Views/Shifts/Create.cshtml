@model VolunteerHub.Models.Shift

@{
    ViewData["Title"] = "Create Shift";

    var volunteerAction =
        ViewBag.VolunteerAction as VolunteerHub.Models.VolunteerAction;
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="mb-4">

            <a asp-action="Index"
               asp-route-actionId="@Model.VolunteerActionId"
               class="text-decoration-none">
                ← Back to Shifts
            </a>

            <h1 class="mt-3 mb-1">
                Create Shift
            </h1>

            @if (volunteerAction != null)
            {
                <p class="text-muted mb-0">
                    Add a new shift for
                    <strong>@volunteerAction.Title</strong>.
                </p>
            }

        </div>


        @if (volunteerAction != null)
        {
            <div class="card mb-4">

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Action Starts
                            </div>

                            <div class="fw-semibold">
                                @volunteerAction.StartDate.ToString("dd MMM yyyy, HH:mm")
                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-muted small">
                                Action Ends
                            </div>

                            <div class="fw-semibold">
                                @volunteerAction.EndDate.ToString("dd MMM yyyy, HH:mm")
                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }


        <div class="card">

            <div class="card-body p-4 p-md-5">

                <form asp-action="Create"
                      method="post">

                    <input asp-for="VolunteerActionId"
                           type="hidden" />


                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    <div class="mb-3">

                        <label asp-for="Title"
                               class="form-label">
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="e.g. Morning Registration Team" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-label">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe what volunteers will do during this shift.">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="StartTime"
                                   class="form-label">
                            </label>

                            <input asp-for="StartTime"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="StartTime"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="EndTime"
                                   class="form-label">
                            </label>

                            <input asp-for="EndTime"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="EndTime"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label asp-for="MaxVolunteers"
                               class="form-label">
                        </label>

                        <input asp-for="MaxVolunteers"
                               type="number"
                               min="1"
                               max="1000"
                               class="form-control" />

                        <span asp-validation-for="MaxVolunteers"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Set the maximum number of volunteers that can be approved for this shift.
                        </div>

                    </div>


                    <div class="mb-3">

                        <label asp-for="RequiredSkill"
                               class="form-label">
                        </label>

                        <input asp-for="RequiredSkill"
                               class="form-control"
                               placeholder="Optional, e.g. First aid" />

                        <span asp-validation-for="RequiredSkill"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="Notes"
                               class="form-label">
                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional notes, meeting point or equipment information.">
                        </textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            Create Shift

                        </button>

                        <a asp-action="Index"
                           asp-route-actionId="@Model.VolunteerActionId"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}