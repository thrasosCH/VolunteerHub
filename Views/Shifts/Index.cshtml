@using VolunteerHub.Constants
@model IEnumerable<VolunteerHub.Models.Shift>

@{
    ViewData["Title"] = "Manage Shifts";

    var volunteerAction =
        ViewBag.VolunteerAction as VolunteerHub.Models.VolunteerAction;

    bool canManageShifts =
        volunteerAction != null &&
        (
            volunteerAction.Status ==
                VolunteerActionStatuses.Draft ||

            volunteerAction.Status ==
                VolunteerActionStatuses.Published
        );
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <div>

        <a asp-controller="VolunteerActions"
           asp-action="MyActions"
           class="text-decoration-none">

            ← Back to My Actions

        </a>


        <h1 class="mt-3 mb-1">
            Manage Shifts
        </h1>


        @if (volunteerAction != null)
        {
            <p class="text-muted mb-0">
                @volunteerAction.Title
            </p>
        }

    </div>


    @if (canManageShifts)
    {
        <a asp-action="Create"
           asp-route-actionId="@volunteerAction!.Id"
           class="btn btn-primary">

            Add New Shift

        </a>
    }

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


@if (volunteerAction != null)
{
    <div class="card mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <div class="text-muted small">
                        Action Starts
                    </div>

                    <div class="fw-semibold">
                        @volunteerAction.StartDate.ToString(
                            "dd MMM yyyy, HH:mm")
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        Action Ends
                    </div>

                    <div class="fw-semibold">
                        @volunteerAction.EndDate.ToString(
                            "dd MMM yyyy, HH:mm")
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        Status
                    </div>


                    @switch (volunteerAction.Status)
                    {
                        case VolunteerActionStatuses.Draft:

                            <span class="badge bg-secondary">
                                Draft
                            </span>

                            break;


                        case VolunteerActionStatuses.Published:

                            <span class="badge bg-primary">
                                Published
                            </span>

                            break;


                        case VolunteerActionStatuses.InProgress:

                            <span class="badge bg-success">
                                In Progress
                            </span>

                            break;


                        case VolunteerActionStatuses.Completed:

                            <span class="badge bg-dark">
                                Completed
                            </span>

                            break;


                        case VolunteerActionStatuses.Cancelled:

                            <span class="badge bg-danger">
                                Cancelled
                            </span>

                            break;


                        default:

                            <span class="badge bg-secondary">
                                @volunteerAction.Status
                            </span>

                            break;
                    }

                </div>

            </div>

        </div>

    </div>


    @if (!canManageShifts)
    {
        <div class="alert alert-info mb-4">

            This opportunity is
            <strong>
                @volunteerAction.Status
            </strong>.

            Shifts can be viewed, but they can no longer be
            created, edited or deleted.

        </div>
    }
}


@if (Model.Any())
{
    <div class="row g-4">

        @foreach (var shift in Model)
        {
            <div class="col-lg-6">

                <div class="card h-100 shadow-sm">

                    <div class="card-body p-4 d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">

                            <div>

                                <h2 class="h5 mb-1">
                                    @shift.Title
                                </h2>

                                <div class="text-muted small">
                                    Shift #@shift.Id
                                </div>

                            </div>


                            <span class="badge bg-light text-dark border">

                                @shift.MaxVolunteers

                                @(shift.MaxVolunteers == 1
                                    ? "volunteer"
                                    : "volunteers")

                            </span>

                        </div>


                        <p class="mb-4">
                            @shift.Description
                        </p>


                        <div class="mb-3">

                            <div class="text-muted small">
                                Date
                            </div>

                            <div class="fw-semibold">
                                @shift.StartTime.ToString(
                                    "dd MMM yyyy")
                            </div>

                        </div>


                        <div class="row mb-3">

                            <div class="col-6">

                                <div class="text-muted small">
                                    Start Time
                                </div>

                                <div class="fw-semibold">
                                    @shift.StartTime.ToString("HH:mm")
                                </div>

                            </div>


                            <div class="col-6">

                                <div class="text-muted small">
                                    End Time
                                </div>

                                <div class="fw-semibold">
                                    @shift.EndTime.ToString("HH:mm")
                                </div>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            shift.RequiredSkill))
                        {
                            <div class="mb-3">

                                <div class="text-muted small">
                                    Required Skill
                                </div>

                                <div class="fw-semibold">
                                    @shift.RequiredSkill
                                </div>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(
                            shift.Notes))
                        {
                            <div class="mb-4">

                                <div class="text-muted small">
                                    Notes
                                </div>

                                <div>
                                    @shift.Notes
                                </div>

                            </div>
                        }


                        @if (canManageShifts)
                        {
                            <div class="mt-auto">

                                <div class="d-flex flex-wrap gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@shift.Id"
                                       class="btn btn-outline-primary">

                                        Edit Shift

                                    </a>


                                    <form asp-action="Delete"
                                          asp-route-id="@shift.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this shift?');">

                                        <button type="submit"
                                                class="btn btn-outline-danger">

                                            Delete

                                        </button>

                                    </form>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="card">

        <div class="card-body text-center py-5">

            <h2 class="h5">
                No shifts created yet
            </h2>


            @if (canManageShifts)
            {
                <p class="text-muted mb-4">
                    Add at least one shift so volunteers can
                    apply to this opportunity.
                </p>

                <a asp-action="Create"
                   asp-route-actionId="@volunteerAction!.Id"
                   class="btn btn-primary">

                    Create First Shift

                </a>
            }
            else
            {
                <p class="text-muted mb-0">
                    No shifts were created for this opportunity.
                </p>
            }

        </div>

    </div>
}